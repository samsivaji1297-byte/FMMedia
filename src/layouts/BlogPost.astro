---
const { title = "FMMedia", description = "Mindset. Identity. Sovereignty.", ogImage = "/og-default.png" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- FMMedia Branding -->
    <style>
      :root {
        --fm-black: #0a0a0a;
        --fm-white: #ffffff;
        --fm-grey: #b3b3b3;
        --fm-accent: #ff4f4f; /* You can change this later */
        --fm-font: "Inter", sans-serif;
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--fm-black);
        color: var(--fm-white);
        font-family: var(--fm-font);
        line-height: 1.6;
      }

      a {
        color: var(--fm-accent);
        text-decoration: none;
      }

      a:hover {
        opacity: 0.8;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
    </style>
  </head>

  <body>
    <slot />
  </body>
</html>
