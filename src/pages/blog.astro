---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<h1 style="margin-bottom: 2rem;">Blog</h1>

<ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1.5rem;">
  {posts.map(post => (
    <li>
      <a href={`/blog/${post.slug}`} style="font-size: 1.2rem; font-weight: 600;">
        {post.data.title}
      </a>
      <div style="color: var(--fm-grey); font-size: 0.9rem;">
        {post.data.description}
      </div>
    </li>
  ))}
</ul>
