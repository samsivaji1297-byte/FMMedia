---
export const prerender = false;

import { getCollection } from 'astro:content';
const entries = await getCollection('sovereignos');
---
<html>
  <body>
    <h1>SovereignOS</h1>
    <ul>
      {entries.map(entry => (
        <li>
          <a href={`/sovereignos/${entry.slug}/`}>{entry.data.title}</a>
        </li>
      ))}
    </ul>
  </body>
</html>
