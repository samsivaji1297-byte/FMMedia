---
import '../../styles/global.css';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug || post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{post.data?.title || post.id} // FM//MEDIA</title>
  </head>
  <body>
    <NavBar />
    <main class="container">
      <article class="article-wrapper">
        <header class="article-header">
          <a href="/blog" class="back-link">← All Dispatches</a>
          <h1>{post.data?.title || post.id.replace('FreeFall_', '').replace('.md', '')}</h1>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .article-wrapper {
    padding: var(--space-lg) 0;
    max-width: 750px;
  }
  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .article-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
  }
  .prose {
    line-height: 1.8;
    font-size: 1.05rem;
    color: var(--text-primary);
  }
  .prose :global(p) {
    margin-bottom: 1.5rem;
  }
  .prose :global(h2), .prose :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
