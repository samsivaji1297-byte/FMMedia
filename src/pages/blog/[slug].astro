---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro"; // Adjust path to your site's layout if available

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug || post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <p><em>{post.data.description}</em></p>
    <hr />
    <Content />
  </article>
</BlogPost>
