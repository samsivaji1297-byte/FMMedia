---
import '../../styles/global.css';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.id).getTime() - new Date(a.id).getTime());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dispatches // FM//MEDIA</title>
  </head>
  <body>
    <NavBar />
    <main class="container">
      <section class="page-header">
        <span class="section-tag">// FREEFALL_DISPATCHES</span>
        <h1>Blog & Dispatches</h1>
        <p>Raw dispatches, high-signal entries, and tactical field notes.</p>
      </section>

      <div class="posts-list">
        {sortedPosts.length > 0 ? (
          sortedPosts.map((post) => (
            <a href={`/blog/${post.slug || post.id.replace(/\.(md|mdx)$/, '')}`} class="post-card">
              <h3>{post.data?.title || post.id.replace('FreeFall_', '').replace('.md', '')}</h3>
              <p>{post.data?.description || 'View dispatch contents →'}</p>
              <span class="post-id">{post.id}</span>
            </a>
          ))
        ) : (
          <p class="empty-state">No dispatches found in collection.</p>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-header {
    padding: var(--space-lg) 0 var(--space-md) 0;
    border-bottom: 1px solid var(--border-color);
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
  }
  .page-header p {
    color: var(--text-secondary);
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border-color);
    border: 1px solid var(--border-color);
    margin-top: var(--space-md);
  }
  .post-card {
    background: var(--bg-primary);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: background 0.2s ease;
  }
  .post-card:hover {
    background: var(--bg-surface);
  }
  .post-card h3 {
    font-size: 1.25rem;
  }
  .post-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  .post-id {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }
</style>
