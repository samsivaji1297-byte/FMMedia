---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import PillarsGrid from '../components/PillarsGrid.astro';
import ProductCTA from '../components/ProductCTA.astro';
import LatestOutputs from '../components/LatestOutputs.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>FM//MEDIA — Sovereign Systems & Digital Assets</title>
  </head>
  <body>
    <NavBar />
    <main class="container">
      <Hero />
      <PillarsGrid />
      <ProductCTA />
      <LatestOutputs />
    </main>
    <Footer />
  </body>
</html>
