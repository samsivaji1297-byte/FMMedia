---
import '../../styles/global.css';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

// Fetch all entries from the sovereignos collection
const osItems = await getCollection('sovereignos');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sovereign OS // FM//MEDIA</title>
  </head>
  <body>
    <NavBar />
    <main class="container">
      <section class="page-header">
        <span class="section-tag">// MINDSET_KERNELS</span>
        <h1>Sovereign OS</h1>
        <p>Execution frameworks, mindset dispatches, and operating principles.</p>
      </section>

      <div class="posts-list">
        {osItems && osItems.length > 0 ? (
          osItems.map((item) => (
            <a href={`/sovereignos/${item.id.replace(/\.(md|mdx)$/, '')}`} class="post-card">
              <h3>{item.data?.title || item.id.replace('Mindset_', '').replace(/\.(md|mdx)$/, '').replace(/_/g, ' ')}</h3>
              <p>{item.data?.description || 'Read framework kernel →'}</p>
              <span class="post-id">{item.id}</span>
            </a>
          ))
        ) : (
          <p class="empty-state">No OS frameworks found in collection (Total loaded: {osItems.length}).</p>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
